{
    "name": "default",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "features": {
      "ghcr.io/stu-bell/devcontainer-features/claude-code:0": {},
      "ghcr.io/devcontainers/features/node:2": {},
      "ghcr.io/devcontainers/features/python:1": {},
      "ghcr.io/dhoeric/features/k9s:1": {},
      "ghcr.io/devcontainers/features/docker-in-docker:4": {},
      "ghcr.io/mpriscella/features/kind:1": {},
      "ghcr.io/devcontainers/features/java:1": {},
    },
    "overrideFeatureInstallOrder": [
        "ghcr.io/devcontainers/features/docker-in-docker",
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/devcontainers/features/python",
        "ghcr.io/devcontainers/features/java",
        "ghcr.io/dhoeric/features/k9s",
        "ghcr.io/mpriscella/features/kind",
        "ghcr.io/stu-bell/devcontainer-features/claude-code",
    ],
    "hostRequirements": {
      "cpus": 5,
      "memory": "32gb",
      "storage": "16gb"
    },
    "remoteEnv": {
      "PODMAN_USERNS": "keep-id",
    },
    "containerUser": "vscode",
    "runArgs": [
      "--init" // Recommended for proper process management
    ],
    "capAdd": [
      "IPC_LOCK"
    ],
    // goose talks to Anthropic in here rather than a local Ollama: no GPU passthrough on a
    // Mac, and a CPU-sized model cannot be trusted to call the tool the demo turns on.
    // run-recipe.sh detects the container and picks this itself; setting it here means the
    // choice is visible rather than inferred.
    "containerEnv": {
      "GOOSE_PROVIDER": "anthropic"
    },
    "postCreateCommand": ".devcontainer/post-create.sh",
  }