# Anthropic — the agent authenticates with this (sk-ant-...)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional override for the goose recipe (demos/agents/goose/run-recipe.sh).
#
# Leave both commented out. The script picks the provider for you: Anthropic inside a
# container — no GPU there, and a small CPU-sized model cannot be trusted to call the tool
# the demo depends on — and Ollama on a host where it is running, which is the path the
# slides show. Uncomment only to force one.
#
# Setting GOOSE_PROVIDER here is not harmless: .env is sourced with `set -a`, so an
# uncommented value overrides the container's own choice and sends the devcontainer looking
# for an Ollama that is not there.
#
# GOOSE_PROVIDER=ollama          # or: anthropic
# GOOSE_MODEL=qwen3.6:35b-a3b-q4_K_M    # default follows the provider; claude-sonnet-5 for anthropic

# Langfuse demo project keys (used both to bootstrap Langfuse and to build the
# collector's OTLP Basic-auth header). Fine to leave as-is for a local demo.
LANGFUSE_PUBLIC_KEY=pk-lf-local-demo
LANGFUSE_SECRET_KEY=sk-lf-local-demo

# Optional: vendor path. If DASH0_AUTH_TOKEN is empty the collector will log
# harmless export errors for the dash0 exporter — that's expected.
DASH0_AUTH_TOKEN=
DASH0_DATASET=default
DASH0_ENDPOINT_OTLP_GRPC_HOSTNAME=ingress.eu-west-1.aws.dash0.com
DASH0_ENDPOINT_OTLP_GRPC_PORT=4317

# Optional: Dynatrace
DT_ENDPOINT="https://<your_dynatrace_tenant>.live.dynatrace.com"
DT_API_TOKEN="dt0c01.<your_dynatrace_api_token>"

